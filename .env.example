
# API Keys
# GROQ_API_KEY is required if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Provider Configuration
# Choose between "groq" or "ollama"
LLM_PROVIDER=groq

# Ollama Configuration (Only required if LLM_PROVIDER=ollama)
# OLLAMA_MODEL defaults to "llama3.2:latest"
OLLAMA_MODEL=llama3.2:latest
# OLLAMA_BASE_URL can be localhost or a remote server endpoint
OLLAMA_BASE_URL=localhost:11434
